{
  "name": "vue-refresh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "test": "node --test tests/*.test.ts",
    "build:demo": "vite build --outDir dist-demo",
    "test:browser": "playwright test",
    "complexity": "node scripts/complexity.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "pinia": "4.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vue": "3.5.42"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0"
  }
}
